@article{Ridders1978,
  author  = {Ridders, C. J. F.},
  title   = {Accurate computation of {F}'(x) and {F}''(x)},
  journal = {Advances in Engineering Software},
  year    = {1978},
  volume  = {4},
  number  = {2},
  pages   = {75--76},
  note    = {The early-stopping rule Neville-table entry selection follows: descend to smaller steps tracking the best error seen so far, and stop as soon as a new error is worse than the best-so-far by more than a safety factor -- rather than searching the whole table for a global minimum, which can pick a deep, noise-contaminated entry that happens to coincidentally agree with its neighbor.},
}

